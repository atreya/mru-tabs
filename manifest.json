{
  "manifest_version": 3,
  "name": "MRU Tabs",
  "description": "Switch Chrome tabs in most-recently-used order.",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "commands": {
    "mru-older-tab": {
      "suggested_key": {
        "mac": "Command+Period"
      },
      "description": "Switch to the next older recently used tab"
    },
    "mru-newer-tab": {
      "suggested_key": {
        "mac": "Command+Shift+Period"
      },
      "description": "Switch to the next newer recently used tab"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
